<mujoco model="tb3_waffle_room">
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <compiler angle="radian"/>
  <visual><global offwidth="640" offheight="480"/></visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="12 12" reflectance="0"/>
    <texture name="aruco_tex" type="2d" file="assets/aruco_0.png"/>
    <material name="aruco_mat" texture="aruco_tex" reflectance="0" specular="0" shininess="0" emission="1"/>
  </asset>

  <default>
    <geom friction="1 0.005 0.0001"/>
    
  </default>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0 0 0" castshadow="false"/>
    <light pos="2 2 3" dir="-1 -1 -1" diffuse="0.5 0.5 0.5" specular="0 0 0" castshadow="false"/>
    <geom name="floor" type="plane" size="3.0 3.0 0.1" material="floor_mat"/>

    <!-- walls -->
    <geom type="box" pos="0 3.0 0.25"  size="3.0 0.05 0.25" rgba="0.85 0.85 0.9 1"/>
    <geom type="box" pos="0 -3.0 0.25" size="3.0 0.05 0.25" rgba="0.85 0.85 0.9 1"/>
    <geom type="box" pos="3.0 0 0.25"  size="0.05 3.0 0.25" rgba="0.85 0.85 0.9 1"/>
    <geom type="box" pos="-3.0 0 0.25" size="0.05 3.0 0.25" rgba="0.85 0.85 0.9 1"/>

    <geom name="obs0" type="box" pos="0.0 0.8 0.25" size="0.25 0.25 0.25" rgba="0.6 0.3 0.2 1"/>
    <geom name="obs1" type="box" pos="1.2 -0.9 0.25" size="0.4 0.2 0.25" rgba="0.6 0.3 0.2 1"/>
    <geom name="obs2" type="box" pos="-1.0 -1.2 0.25" size="0.2 0.4 0.25" rgba="0.6 0.3 0.2 1"/>

    <!-- charging dock with ArUco marker on its front face -->
    <body name="dock" pos="2.6 1.5 0" euler="0 0 3.141592653589793">
      <geom name="dock_box" type="box" pos="-0.05 0 0.15" size="0.05 0.2 0.15" rgba="0.2 0.2 0.25 1"/>
      <!-- plane normal is +z; rotate so it faces -x of the dock body (= into the room) -->
      <geom name="marker" type="plane" pos="0.001 0 0.12" zaxis="1 0 0"
            size="0.1250 0.1250 0.001" material="aruco_mat" contype="0" conaffinity="0"/>
      <site name="marker_site" pos="0 0 0.12" size="0.01" rgba="0 1 0 0"/>
    </body>

    <!-- TurtleBot3 Waffle (differential drive) -->
    <body name="robot" pos="0 0 0">
      <!-- planar base: x, y, yaw, driven kinematically (unicycle model) by velocity servos.
           MuJoCo supplies the world, collisions, LiDAR ray-casting and the camera; the
           wheel/floor contact is NOT simulated (wheels are visual + encoder joints only).
           Wheel slip / process noise is injected in tb3sim.step(). -->
      <joint name="base_x"   type="slide" axis="1 0 0"/>
      <joint name="base_y"   type="slide" axis="0 1 0"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1"/>
      <site name="base_site" pos="0 0 0" size="0.01" rgba="1 0 0 0"/>
      <geom name="chassis" type="box" pos="0 0 0.075" size="0.14 0.14 0.035" rgba="0.1 0.1 0.1 1" mass="1.5" friction="0.2"/>
      <geom name="nose" type="box" pos="0.14 0 0.075" size="0.02 0.05 0.02" rgba="1 0.5 0 1" mass="0.01"/>
      <!-- caster balls, visual only (the planar joint carries the weight) -->
      <geom name="caster_f" type="sphere" pos="0.11000000000000001 0 0.015" size="0.015" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 1" mass="0.05"/>
      <geom name="caster_b" type="sphere" pos="-0.11000000000000001 0 0.015" size="0.015" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 1" mass="0.05"/>

      <body name="wheel_l" pos="0 0.1435 0.033">
        <joint name="wheel_l" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.033 0.018" euler="1.5707963 0 0" rgba="0.2 0.2 0.2 1" mass="0.1" contype="0" conaffinity="0"/>
      </body>
      <body name="wheel_r" pos="0 -0.1435 0.033">
        <joint name="wheel_r" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.033 0.018" euler="1.5707963 0 0" rgba="0.2 0.2 0.2 1" mass="0.1" contype="0" conaffinity="0"/>
      </body>

      <!-- LDS-01 LiDAR: N rays in the horizontal plane -->
      <body name="lidar" pos="0 0 0.17">
        <geom type="cylinder" size="0.035 0.02" rgba="0.3 0.3 0.3 1" mass="0.1" contype="0" conaffinity="0"/>
      <site name="ray0" pos="0 0 0" zaxis="1.000000 0.000000 0" size="0.005"/>
